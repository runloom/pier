            "output": "{\n  \"ok\": true,\n  \"data\": {\n    \"panelId\": \"terminal-…\",\n    \"windowId\": \"…\"\n  }\n}"
          },
          {
            "id": "terminal-profiles",
            "name": "terminal profiles list|get|set|delete",
            "status": "shipped",
            "synopsis": "pier terminal profiles list --json\npier terminal profiles get <id> --json\npier terminal profiles set <id> … --json\npier terminal profiles delete <id> --json",
            "description": "管理终端配置档。",
            "output": "{\n  \"ok\": true,\n  \"data\": {\n    \"default\": { \"cwd\": \"/Users/you/project\" }\n  }\n}"
          },
          {
            "id": "terminal-list",
            "name": "terminal list",
            "status": "planned",
            "synopsis": "pier terminal list [--window <id>] --json",
            "description": "列出终端运行实例（含运行代际等）。",
            "output": "{\n  \"ok\": true,\n  \"data\": {\n    \"terminals\": [{\n      \"panelId\": \"terminal-abc\",\n      \"cwd\": \"/Users/you/project\",\n      \"runtimeId\": \"…\",\n      \"generation\": 3\n    }]\n  }\n}"
          },
          {
            "id": "terminal-get",
            "name": "terminal get",
            "status": "planned",
            "synopsis": "pier terminal get --panel <id> --json",
