  "data": {
    "meta": {
      "title": "Pier 本机 CLI 使用手册",
      "subtitle": "在终端控制已打开的 Pier。先学会开工，再按任务查找，最后查命令参考。",
      "status": "使用手册",
      "version": "v1.1"
    },
    "bluf": "先启动 Pier，再运行 pier（或 pnpm --silent cli:dev）。新手路径：status → open . → agents catalog → agents start（持久）。脚本一律加 --json。本手册按「开始使用 → 常用任务 → 命令参考 → 智能体 → 疑难」组织；暂未实现的命令会标明，勿写入脚本依赖。 一次性提问请用各 agent 原生 CLI，不提供 pier agents invoke。",
    "context": "面向使用 Pier 的人与脚本作者。CLI 是本机工作台控制入口，不是远程 API，也不是智能体权限系统。",
    "goals": [
      "60 秒内完成第一次成功调用",
      "用任务（task）而不是实现状态找答案",
      "命令参考按领域（窗口/终端/智能体…）分组",
      "每条命令有可抄写的语法与输出示意",
      "暂未实现能力可见但不误导为可用"
    ],
    "nonGoals": [
      "不把工程波次 / 架构设计当作用户主路径",
      "不把 CLI 写成权限与委派管理系统",
      "不要求用户通读全文",
      "不提供 pier agents invoke；一次性使用各 agent 原生能力"
    ],
    "design": {
      "readingSpine": "左目录（开始 / 任务 / 参考 / 智能体 / 疑难）+ 右正文",
      "iaNotes": [
        "文档壳：左 sticky 目录 + 右文章流（Stripe / MDN / GitHub Docs 同构）",
        "顶栏仅标题与搜索，不用五段胶囊 Tab 切换整本手册",
        "对齐 clig.dev / Stripe CLI：上手优先，命令按名词域分组",
        "状态用页内徽标，不当一级导航"
      ]
    },
    "alternatives": [
      {
        "name": "按已实现 / 暂未实现分 Tab",
        "rejectReason": "这是工程状态，不是用户任务；新手会先撞上大段不可用命令"
      },
      {
        "name": "纯长 Markdown 无结构",
        "rejectReason": "难扫读、难跳转，不符合手册「按需查阅」习惯"
      }
    ],
    "quickStart": {
      "prerequisite": "必须先打开 Pier 应用（开发态：pnpm dev）。CLI 只连接本机已运行实例。",
      "firstCommands": [
        {
          "title": "1. 确认连上",
          "cmd": "pier status --json",
          "note": "开发态：pnpm --silent cli:dev -- status --json"
        },
        {
          "title": "2. 打开当前目录",
          "cmd": "pier open . --json",
          "note": "会打开绑定到该项目的终端面板"
        },
        {
          "title": "3. 看有哪些面板",
          "cmd": "pier panels list --json",
          "note": "记下 panelId，便于 focus"
        },
        {
          "title": "4. 看智能体运行情况",
          "cmd": "pier agents list --json",
          "note": "没有运行中的智能体时列表为空，属正常"
        }
      ],
      "binPaths": [
        "安装包：Pier.app/Contents/Resources/bin/pier",
        "开发态：pnpm --silent cli:dev -- <命令…>",
        "或：node ./bin/pier.mjs <命令…>"
      ]
    },
    "globalOptions": [
      {
        "flag": "--json",
        "meaning": "输出 JSON（脚本必加）"
      },
      {
        "flag": "--print-envelope",
        "meaning": "只打印请求，不执行"
      },
      {
        "flag": "--no-focus",
        "meaning": "尽量不抢窗口前台"
      },
      {
        "flag": "--window <id>",
        "meaning": "指定窗口（见 windows list）"
      }
    ],
    "outputShapes": {
      "success": "{\n  \"ok\": true,\n  \"requestId\": \"…\",\n  \"data\": { }\n}",
      "failure": "{\n  \"ok\": false,\n  \"requestId\": \"…\",\n  \"error\": {\n    \"code\": \"…\",\n    \"message\": \"…\"\n  }\n}"
    },
    "tasks": [
      {
        "id": "check-online",
        "title": "确认 Pier 在线",
        "when": "第一次使用或脚本开头",
        "steps": [
          "启动 Pier",
          "运行 pier status --json",
          "看到 ok: true 即可"
        ]
      },
      {
        "id": "open-project",
        "title": "打开项目文件夹",
        "when": "想在 Pier 里进入某个仓库",
        "steps": [
          "pier open /path/to/repo --json",
          "或 pier open . --split right --json 在当前窗口旁开"
        ]
      },
      {
        "id": "find-panel",
        "title": "找到并聚焦某个面板",
        "when": "多个终端/文件面板时",
        "steps": [
          "pier panels list --json 记下 panelId",
          "pier panels focus <panelId> --json"
        ]
      },
      {
        "id": "new-terminal",
        "title": "新开一个终端",
        "when": "需要额外终端，或在终端里启动智能体 CLI",
        "steps": [
          "pier terminal open --cwd . --json",
          "或 pier terminal open -- claude --json"
        ]
      },
      {
        "id": "see-agents",
        "title": "查看智能体目录与运行中的实例",
        "when": "想知道本机有哪些智能体、哪些面板在跑",
        "steps": [
          "pier agents catalog --json",
          "pier agents list --json",
          "pier agents get --panel <panelId> --json"
        ]
      },
      {
        "id": "shell-task",
        "title": "运行一个 Shell 任务",
        "when": "使用项目里配置的 build/test 等任务",
        "steps": [
          "pier tasks list --json",
          "pier tasks run <taskId> --json",
          "pier tasks status <runId> --json"
        ]
      },
      {
        "id": "worktree",
        "title": "列出或打开 Git 工作树",
        "when": "多工作树切换",
        "steps": [
          "pier worktrees list --path <仓库> --json",
          "pier worktrees open <路径> --json"
        ]
      }
    ],
    "domains": [
      {
        "id": "app",
        "label": "应用与打开",
        "blurb": "状态检查与打开文件夹。",
        "commands": [
          {
            "id": "status",
            "name": "status",
            "status": "shipped",
            "synopsis": "pier status --json",
            "description": "确认本机 Pier 是否在线，并返回简要状态。",
            "output": "{\n  \"ok\": true,\n  \"requestId\": \"…\",\n  \"data\": {\n    \"appVersion\": \"0.1.x\",\n    \"platform\": \"darwin\"\n  }\n}"
          },
          {
            "id": "open",
            "name": "open",
            "status": "shipped",
            "synopsis": "pier open <路径> [--window <id>] [--split right|left|below|above] [--no-focus] --json",
            "description": "在 Pier 中打开目录，并带上 Git 与工作树信息。",
            "examples": [
              "pier open . --json",
              "pier open ~/proj --split right --json"
            ],
            "output": "{\n  \"ok\": true,\n  \"data\": {\n    \"panelId\": \"terminal-…\",\n    \"windowId\": \"…\"\n  }\n}"
          },
          {
            "id": "version",
            "name": "version",
            "status": "planned",
            "synopsis": "pier version --json",
            "description": "打印 CLI / 应用 / 协议版本。",
            "output": "{\n  \"ok\": true,\n  \"data\": {\n    \"cliVersion\": \"0.1.x\",\n    \"appVersion\": \"0.1.x\"\n  }\n}"
          },
          {
            "id": "doctor",
            "name": "doctor",
            "status": "planned",
            "synopsis": "pier doctor --json",
            "description": "本机连接与环境自检。",
            "output": "{\n  \"ok\": true,\n  \"data\": {\n    \"socket\": \"ok\",\n    \"appRunning\": true,\n    \"issues\": []\n  }\n}"
          },
          {
            "id": "app-capabilities",
            "name": "capabilities",
            "status": "planned",
            "synopsis": "pier capabilities --json",
            "description": "协议与本机 CLI 能力列表（规划；只读协商）。",
            "output": "{\n  \"ok\": true,\n  \"data\": {\n    \"capabilities\": []\n  }\n}"
          },
          {
            "id": "snapshot",
            "name": "snapshot",
            "status": "planned",
            "synopsis": "pier snapshot [--include windows,panels,activity] --json",
            "description": "多资源原子快照，供脚本对账。",
            "output": "{\n  \"ok\": true,\n  \"data\": {\n    \"bootId\": \"…\",\n    \"windows\": [],\n    \"panels\": []\n  }\n}"
          },
          {
            "id": "watch",
            "name": "watch",
            "status": "planned",
            "synopsis": "pier watch [--after-revision <n>] --json",
            "description": "全局事实流（JSONL）。游标失效时需重新 snapshot。",
            "output": "{\"type\":\"event\",\"revision\":13,\"resource\":\"panels\"}"
          }
        ]
      },
      {
        "id": "windows-panels",
        "label": "窗口与面板",
        "blurb": "发现界面位置并聚焦。",
        "commands": [
          {
            "id": "windows-list",
            "name": "windows list",
            "status": "shipped",
            "synopsis": "pier windows list --json",
            "description": "列出所有窗口。",
            "output": "{\n  \"ok\": true,\n  \"data\": {\n    \"windows\": [{ \"id\": \"main\", \"focused\": true }]\n  }\n}"
          },
          {
            "id": "windows-focus",
            "name": "windows focus",
            "status": "shipped",
            "synopsis": "pier windows focus <窗口id> --json",
            "description": "聚焦指定窗口。",
            "output": "{\n  \"ok\": true,\n  \"data\": { \"windowId\": \"main\" }\n}"
          },
          {
            "id": "panels-list",
            "name": "panels list",
            "status": "shipped",
            "synopsis": "pier panels list [--window <id>] --json",
            "description": "列出面板。不加 --json 时可能按窗口分组打印。",
            "output": "{\n  \"ok\": true,\n  \"data\": {\n    \"panels\": [{\n      \"panelId\": \"terminal-abc\",\n      \"windowId\": \"main\",\n      \"title\": \"Terminal\",\n      \"focused\": true\n    }]\n  }\n}"
          },
          {
            "id": "panels-focus",
            "name": "panels focus",
            "status": "shipped",
            "synopsis": "pier panels focus <面板id> [--window <id>] [--no-focus] --json",
            "description": "聚焦面板。",
