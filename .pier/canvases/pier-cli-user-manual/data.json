          }
        ]
      },
      {
        "id": "terminal",
        "label": "终端",
        "blurb": "打开终端与配置档已可用；向已有终端注入按键等仍在规划中。",
        "commands": [
          {
            "id": "terminal-open",
            "name": "terminal open",
            "status": "shipped",
            "synopsis": "pier terminal open [--cwd <路径>] [--profile <id>] [--env KEY=VALUE] [--command <cmd> | -- <cmd…>] [--window] [--split] [--no-focus] --json",
