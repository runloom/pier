          },
          {
            "id": "terminal-interrupt",
            "name": "terminal interrupt",
            "status": "planned",
            "synopsis": "pier terminal interrupt --panel <id> --json",
            "description": "中断（如 Ctrl-C）。",
            "output": "{\n  \"ok\": true,\n  \"data\": { \"signaled\": true }\n}"
          },
          {
            "id": "terminal-terminate",
            "name": "terminal terminate",
            "status": "planned",
            "synopsis": "pier terminal terminate --panel <id> [--force] --json",
            "description": "结束终端进程。",
            "output": "{\n  \"ok\": true,\n  \"data\": { \"terminated\": true }\n}"
          },
          {
            "id": "terminal-wait",
            "name": "terminal wait",
            "status": "planned",
            "synopsis": "pier terminal wait --panel <id> --until idle|exited [--timeout-ms 60000] --json",
            "description": "等待终端进入某状态。",
            "output": "{\n  \"ok\": true,\n  \"data\": {\n    \"until\": \"idle\",\n    \"reached\": true\n  }\n}"
          },
          {
            "id": "terminal-watch",
            "name": "terminal watch",
            "status": "planned",
            "synopsis": "pier terminal watch --panel <id> --json",
            "description": "订阅终端相关事件流。",
            "output": "{\"type\":\"event\",\"kind\":\"cwd.changed\",\"cwd\":\"…\"}"
          }
        ]
