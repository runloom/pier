{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "comment": "Canvases lane: `.pier/**` is outside the host include. App compile uses host stubs; this project maps `pier/host` to the SDK types so canvas check does not load renderer.",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"],
      "@main/*": ["./src/main/*"],
      "@preload/*": ["./src/preload/*"],
      "@plugins/*": ["./src/plugins/*"],
      "@pier/ui/*": ["./packages/ui/src/*"],
      "@pier/ui": ["./packages/ui/src"],
      "pier/canvas": ["./tests/support/pier-canvas.ts"],
      "pier/host": ["./resources/system-skills/pier-canvas/sdk/host.d.ts"],
      "@pier-applet/pier.tasks/task-dag": [
        "./packages/plugin-tasks/applets/task-dag/index.applet.tsx"
      ],
      "@pier-applet/pier.tasks/task-list": [
        "./packages/plugin-tasks/applets/task-list/index.applet.tsx"
      ],
      "@pier-applet/pier.tasks/tracker-board": [
        "./packages/plugin-tasks/applets/tracker-board/index.applet.tsx"
      ]
    }
  },
  "include": [
    ".pier/canvases/**/*.canvas.tsx",
    ".pier/types/**/*.d.ts",
    "packages/plugin-tasks/applets/**/*.ts",
    "packages/plugin-tasks/applets/**/*.tsx",
    "src/renderer/global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "dist",
    "build",
    ".pier/canvases/**/*.canvas.solid.tsx",
    ".pier/canvases/**/*.canvas.vue.tsx",
    ".pier/canvases/**/*.canvas.svelte"
  ]
}
