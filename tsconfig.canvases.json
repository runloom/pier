{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "comment": "Canvases lane: `.pier/**` is outside the host include. `pier/canvas` is a compile-time stub in the app; root tsconfig maps it to tests/support for types.",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [".pier/canvases/**/*.canvas.tsx", "src/renderer/global.d.ts"],
  "exclude": [
    "node_modules",
    "out",
    "dist",
    "build",
    ".pier/canvases/**/*.canvas.solid.tsx",
    ".pier/canvases/**/*.canvas.vue.tsx",
    ".pier/canvases/**/*.canvas.svelte"
  ]
}
