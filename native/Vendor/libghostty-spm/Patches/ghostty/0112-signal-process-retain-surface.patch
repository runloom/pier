+/// IO-thread-only signal path. NOTE_EXIT pins the owned leader until group
+/// cleanup finishes. Never reuse Subprocess.stop (blocking teardown).
+pub fn signalProcess(self: *Exec, td: *termio.Termio.ThreadData, force: bool) void {
+    if (td.backend.exec.exited) return;
+    if (comptime builtin.os.tag == .windows) return;
+    const execdata = &td.backend.exec;
+    if (!execdata.stop_requested) {
+        execdata.stop_requested = true;
+        execdata.stop_owner = self;
+        if (!force) execdata.stop_timer.run(td.loop, &execdata.stop_timer_c, 2000, termio.Termio.ThreadData, td, stopTimer);
+    }
+    if (force) execdata.stop_forced = true;
+    defer {
+        if (comptime builtin.os.tag == .macos) {
+            if (force) finishPendingExit(td);
+        }
+    }
+    const c = Subprocess.c;
+    const signal: c_int = if (force) c.SIGKILL else c.SIGTERM;
+    switch (self.subprocess.process orelse return) {
+        .fork_exec => |cmd| {
+            const pid = cmd.pid orelse return;
+            const pgid = execdata.owned_pgid orelse c.getpgid(pid);
+            if (pgid < 0) return; // watcher, not ESRCH, confirms exit
+            const host_group = c.getpgid(0);
+            // Between fork and setsid the child still shares our group.
+            // Signal only our direct child; never wait/spin on AppKit or IO.
+            if (pgid == host_group) {
+                _ = c.kill(pid, signal);
+                return;
+            }
+            if (pgid != pid) return;
+            execdata.owned_pgid = pgid;
+            // Signal the PTY's current foreground group atomically through
+            // its kernel-owned endpoint, never a potentially reused job PGID.
+            // Detached jobs/new sessions are outside the owned process group.
+            if (self.subprocess.pty) |pty| {
+                if (comptime builtin.os.tag == .macos) _ = c.ioctl(pty.master, c.TIOCSIG, signal);
+            }
+            _ = c.killpg(pgid, signal);
+        },
+        .flatpak => {},
+    }
+}
