+fn notifyPendingChildExited(td: *termio.Termio.ThreadData, exit_code: u32) void {
+    if (comptime builtin.os.tag != .macos) return;
+    const execdata = &td.backend.exec;
+    if (execdata.child_exit_notified or execdata.exited or execdata.shutting_down) return;
+    execdata.child_exit_notified = true;
+    const runtime_ms: u64 = runtime: {
+        const process_end = std.time.Instant.now() catch break :runtime 0;
+        break :runtime process_end.since(execdata.start) / std.time.ns_per_ms;
+    };
+    _ = td.surface_mailbox.push(.{
+        .child_exited = .{
+            .exit_code = exit_code,
+            .runtime_ms = runtime_ms,
+        },
+    }, .{ .forever = {} });
+}
+
+fn finishPendingExit(td: *termio.Termio.ThreadData) void {
+    if (comptime builtin.os.tag != .macos) return;
+    const execdata = &td.backend.exec;
+    if (execdata.exited) return;
+    const process = execdata.process orelse return;
+    if (execdata.stop_requested and !execdata.stop_forced) return;
+    // WNOHANG is mandatory even after NOTE_EXIT. A short retry also recovers
+    // a failed kqueue registration without ever fabricating a process exit.
+    const waited = posix.waitpid(process.pid, posix.W.NOHANG);
+    if (waited.pid == 0) {
+        if (!execdata.shutting_down) execdata.exit_timer.run(td.loop, &execdata.exit_timer_c, 50, termio.Termio.ThreadData, td, retryProcessExit);
+        return;
+    }
+    execdata.pending_exit = null;
+    if (execdata.shutting_down) {
+        // AppKit is joining this IO thread; do not push a blocking UI message.
+        execdata.exited = true;
+        return;
+    }
+    const code: u32 = if (posix.W.IFEXITED(waited.status)) posix.W.EXITSTATUS(waited.status) else 128 + posix.W.TERMSIG(waited.status);
+    if (execdata.child_exit_notified) {
+        execdata.exited = true;
+        return;
+    }
+    processExitCommon(td, code);
+}
+
+fn retryProcessExit(td_: ?*termio.Termio.ThreadData, _: *xev.Loop, _: *xev.Completion, r: xev.Timer.RunError!void) xev.CallbackAction {
+    r catch return .disarm;
+    finishPendingExit(td_.?);
+    return .disarm;
+}
+
+fn rawProcessExit(userdata: ?*anyopaque, _: *xev.Loop, _: *xev.Completion, result: xev.Result) xev.CallbackAction {
+    const td: *termio.Termio.ThreadData = @ptrCast(@alignCast(userdata.?));
+    const code = result.proc catch |err| {
+        if (err == error.Canceled) return .disarm;
+        log.warn("process watcher failed, retrying waitpid err={}", .{err});
+        finishPendingExit(td);
+        return .disarm;
+    };
+    td.backend.exec.pending_exit = code;
+    notifyPendingChildExited(td, code);
+    if (!td.backend.exec.stop_requested or td.backend.exec.stop_forced) finishPendingExit(td);
+    return .disarm;
