+fn stopTimer(td_: ?*termio.Termio.ThreadData, _: *xev.Loop, _: *xev.Completion, r: xev.Timer.RunError!void) xev.CallbackAction {
+    r catch return .disarm;
+    const td = td_.?;
+    if (td.backend.exec.stop_owner) |owner| owner.signalProcess(td, true);
+    return .disarm;
+}
