diff --git a/src/os/host_user_messages.zig b/src/os/host_user_messages.zig
new file mode 100644
--- /dev/null
+++ b/src/os/host_user_messages.zig
@@ -0,0 +1,48 @@
+const std = @import("std");
+
+/// Thin wrapper around embedder-provided C API (implemented by Pier Swift).
+/// Undefined at libghostty link time; resolved when linking the host binary.
+extern fn ghostty_host_messages_get(key: [*:0]const u8) callconv(.c) ?[*:0]const u8;
+
+pub fn get(key: []const u8) ?[:0]const u8 {
+    var buf: [128]u8 = undefined;
+    if (key.len >= buf.len) return null;
+    @memcpy(buf[0..key.len], key);
+    buf[key.len] = 0;
+    const ptr = ghostty_host_messages_get(buf[0..key.len :0].ptr) orelse return null;
+    return std.mem.span(ptr);
+}
+
+/// Replace `{{name}}` placeholders. Caller owns result.
+pub fn format(
+    alloc: std.mem.Allocator,
+    key: []const u8,
+    replacements: []const struct { []const u8, []const u8 },
+) ?[]u8 {
+    const template = get(key) orelse return null;
+    var out: std.ArrayListUnmanaged(u8) = .empty;
+    errdefer out.deinit(alloc);
+    out.ensureTotalCapacity(alloc, template.len) catch return null;
+    var i: usize = 0;
+    while (i < template.len) {
+        if (std.mem.startsWith(u8, template[i..], "{{")) {
+            if (std.mem.indexOf(u8, template[i + 2 ..], "}}")) |end| {
+                const name = template[i + 2 .. i + 2 + end];
+                var replaced = false;
+                for (replacements) |pair| {
+                    if (std.mem.eql(u8, pair[0], name)) {
+                        out.appendSlice(alloc, pair[1]) catch return null;
+                        replaced = true;
+                        break;
+                    }
+                }
+                if (!replaced) out.appendSlice(alloc, template[i .. i + 4 + end]) catch return null;
+                i += 4 + end;
+                continue;
+            }
+        }
+        out.append(alloc, template[i]) catch return null;
+        i += 1;
+    }
+    return out.toOwnedSlice(alloc) catch null;
+}
