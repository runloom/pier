+    /// Read the application-requested cursor visibility (DECTCEM mode 25).
+    /// This reflects the mode bit as last set by the running application;
+    /// host-side cursor suppression (ghostty_surface_set_cursor_suppress)
+    /// is a render-layer gate and does NOT affect this value. Embedders use
+    /// this as a probe for "the TUI's input field is focused" — modern TUIs
+    /// hide the hardware cursor exactly when their input loses focus.
+    export fn ghostty_surface_cursor_visible(surface: *Surface) bool {
+        surface.core_surface.renderer_state.mutex.lock();
+        defer surface.core_surface.renderer_state.mutex.unlock();
+        return surface.core_surface.io.terminal.modes.get(.cursor_visible);
+    }
