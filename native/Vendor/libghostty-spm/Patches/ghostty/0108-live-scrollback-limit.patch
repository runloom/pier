+    /// Pier patch (0108): change the primary screen scrollback byte limit
+    /// at runtime, immediately freeing pages beyond the new limit. Lets
+    /// embedders shrink hidden terminals under memory pressure and apply
+    /// scrollback preference changes to live surfaces.
+    export fn ghostty_surface_set_scrollback_limit(
+        surface: *Surface,
+        limit: usize,
+    ) void {
+        surface.core_surface.renderer_state.mutex.lock();
+        defer surface.core_surface.renderer_state.mutex.unlock();
+        const term = &surface.core_surface.io.terminal;
+        if (term.screens.get(.primary)) |primary| {
+            primary.pages.setMaxSize(limit);
+        }
+    }
