+/// Pier patch (0108): change the scrollback byte limit at runtime and
+/// immediately destroy the oldest pages until the list fits the new
+/// limit. The active area is never pruned. Caller must hold the
+/// renderer state mutex (same contract as all terminal mutations).
+pub fn setMaxSize(self: *PageList, max_size: usize) void {
+    defer self.assertIntegrity();
+    self.explicit_max_size = max_size;
+    while (self.pages.first != null and
+        self.pages.first != self.pages.last and
+        self.page_size > self.maxSize())
+    {
+        const first = self.pages.popFirst().?;
+        self.total_rows -= first.data.size.rows;
+
+        // Never prune rows the active area still needs.
+        if (self.total_rows < self.rows) {
+            self.pages.prepend(first);
+            self.total_rows += first.data.size.rows;
+            return;
+        }
+
+        // Keep the viewport pin cache consistent (same rules as grow()).
+        if (self.viewport == .pin) viewport: {
+            if (self.viewport_pin_row_offset) |*v| {
+                if (v.* < first.data.size.rows) {
+                    self.viewport = .top;
+                    break :viewport;
+                }
+                v.* -= first.data.size.rows;
+            }
+        }
+
+        // Retarget tracked pins that pointed into the pruned page.
+        const pin_keys = self.tracked_pins.keys();
+        for (pin_keys) |p| {
+            if (p.node != first) continue;
+            p.node = self.pages.first.?;
+            p.y = 0;
+            p.x = 0;
+            p.garbage = true;
+        }
+        self.viewport_pin.garbage = false;
+
+        self.destroyNode(first);
+    }
+}
