+/// Pier patch (0109): keystroke follow still snaps typing / Enter /
+/// Backspace back to live, but bare arrows and Page stay put so Codex /
+/// Cursor menus do not yank the host scrollbar. Ctrl/Alt/Super chords
+/// keep the Ghostty default (prompt editing). Shift-only stays nav.
+fn keystrokeFollowsViewport(event: input.KeyEvent) bool {
+    if (event.mods.ctrl or event.mods.alt or event.mods.super) return true;
+    return switch (event.key) {
+        .arrow_up,
+        .arrow_down,
+        .arrow_left,
+        .arrow_right,
+        .page_up,
+        .page_down,
+        .numpad_up,
+        .numpad_down,
+        .numpad_left,
+        .numpad_right,
+        .numpad_page_up,
+        .numpad_page_down,
+        => false,
+        else => true,
+    };
+}
