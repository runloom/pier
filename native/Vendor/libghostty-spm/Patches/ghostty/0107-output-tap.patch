+/// Pier patch (0107): set or clear the host raw-output tap.
+pub fn setPierOutputTap(
+    self: *Termio,
+    cb: ?PierOutputTapFn,
+    userdata: ?*anyopaque,
+) void {
+    self.renderer_state.mutex.lock();
+    defer self.renderer_state.mutex.unlock();
+    self.pier_output_tap = cb;
+    self.pier_output_tap_userdata = userdata;
+}
+
 /// Process output from readdata but the lock is already held.
 fn processOutputLocked(self: *Termio, buf: []const u8) void {
+    // Pier patch (0107): forward raw PTY bytes to the host tap before any
+    // parsing so transcripts capture exactly what the process emitted.
+    if (self.pier_output_tap) |tap| {
+        tap(self.pier_output_tap_userdata, buf.ptr, buf.len);
+    }
+
     // Schedule a render. We can call this first because we have the lock.
     self.terminal_stream.handler.queueRender() catch unreachable;
 
