.DS_Store
__pycache__/
*.pyc
node_modules
# Bundled tsserver plugin (tsserver loads `<probe>/node_modules/<name>`).
!/resources/lsp-plugins/node_modules/
!/resources/lsp-plugins/node_modules/pier-canvas-modules/
!/resources/lsp-plugins/node_modules/pier-canvas-modules/**
# build/ 默认忽略; 但 electron-builder buildResources (icon.*, entitlements) 必须入库.
/build/*
!/build/icon.icns
!/build/icon.ico
!/build/icon.png
!/build/Assets.car
!/build/Assets.car.inputs
!/build/app-icon-source.svg
!/build/icons/
!/build/icons/*.png
!/build/design-sources/
!/build/entitlements.mac.plist
!/build/zh-Hans.lproj/
!/build/zh-Hans.lproj/InfoPlist.strings
!/build/zh_CN.lproj/
!/build/zh_CN.lproj/InfoPlist.strings
/package
.env
.env.*
!.env.example
electron-builder.env
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.playwright-mcp/
.omc/
# .claude 本地配置不入库，仅放行项目级 skills.
.claude/*
!.claude/skills/
.playwright-cli/


# Electron build artifacts
/out/
src/renderer/out/
/dist-builder/
/dist-electron/

# Coverage
coverage/

# Playwright E2E artifacts
test-results/
playwright-report/

# Agent cancel capture scratch (remote/local Esc 语料)
.tmp-cancel-capture/

# Editor / OS
.idea/
.vscode/
*.swp
*.swo

# TypeScript
*.tsbuildinfo

# Logs
*.log

# Worktrees
.worktrees/

# Per-worktree dev profile
.pier-dev/

# e2e runner remote build marker (scripts/e2e-runner/run-e2e.sh)
.pier-e2e-last-build-sha


.superpowers/


# cursor
.cursor/

# codebuddy
.codebuddy/

# libghostty 本地构建缓存（scripts/build-libghostty.sh 拉取）
/.ghostty-src/
/.libghostty-spm-src/
/.libghostty-build-tmp/

# GhosttyKit.xcframework 由 scripts/build-libghostty.sh 现地构建，不入库
/native/Vendor/libghostty-spm/GhosttyKit.xcframework/

# Per-worktree vite 依赖优化缓存（见 electron.vite.config.ts cacheDir 注释）
/.vite/

# Plugin build outputs
/packages/plugin-*/dist/
/packages/plugin-*/dist-pkg/

# Local code-signing material (CSR/private key)
.signing/

# Ephemeral CI release target list (Release Plugin job)
/release-targets.json


.agents/skills/
.claude/skills/

# Pier system-skill projections (design v8 §8): published from app
# resources/system-skills into each project at ensureReady / skills.snapshot.
# Canonical content is resources/system-skills/<id>; never treat library as
# the edit source. Live projection is `.pier/skills/library/pier-*` only.
# Swap leftovers / quarantine evidence are runtime debris, not a second skill.
.pier/skills/library/pier-*/
.pier/skills/library/.pier-system-skill-*/

# Worktree incarnation registry (runtime local state; path → UUID).
# Written by worktree identity services; never commit.
.pier/worktree-incarnations.json

# Generated canvas applet module declarations (scripts/generate-canvas-applet-types.mjs)
.pier/types/applets.d.ts

.commandcode/taste
