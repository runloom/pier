#!/usr/bin/env sh
# Correctness before remote CI (first-pass green).
# Default: preflight:push = static + unit + component + plugin-index.
# Stronger (publish / risky): PIER_PREFLIGHT=merge|ci|full
set -e
tier="${PIER_PREFLIGHT:-push}"
case "$tier" in
  push | merge | ci | full)
    pnpm "preflight:${tier}"
    ;;
  *)
    echo "pre-push: unknown PIER_PREFLIGHT=${tier} (use push|merge|ci|full)" >&2
    exit 2
    ;;
esac
