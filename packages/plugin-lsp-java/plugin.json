{
  "apiVersion": 1,
  "commands": [],
  "description": "Java language service via jdtls when the Eclipse JDT language server is on PATH.",
  "engines": {
    "pier": ">=0.1.0 <0.2.0"
  },
  "id": "pier.lsp-java",
  "locales": {
    "en": {
      "name": "Java Language",
      "description": "Install for Java syntax highlighting. Put jdtls on PATH for language features."
    },
    "zh-CN": {
      "name": "Java 语言",
      "description": "安装后获得 Java 语法高亮。将 jdtls 装到 PATH 后还有补全与跳转。"
    }
  },
  "main": "dist/main.js",
  "name": "Java Language",
  "panels": [],
  "permissions": ["lsp:provide", "languageMode:provide"],
  "publisher": "Pier",
  "renderer": "dist/renderer.js",
  "settingsPages": [],
  "terminalStatusItems": [],
  "version": "1.0.0",
  "workbenchWidgets": [],
  "languageModes": [
    {
      "displayName": "Java",
      "extensions": [".java"],
      "highlight": "java",
      "id": "java",
      "languageId": "java",
      "priority": 70
    }
  ],
  "languageServers": [
    {
      "args": [],
      "command": "jdtls",
      "displayName": "Java",
      "extensions": [".java"],
      "id": "jdtls",
      "installCommand": "brew install jdtls",
      "languageIds": ["java"],
      "priority": 70,
      "rootMarkers": [
        "pom.xml",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts"
      ]
    }
  ]
}
